#----------------------DOMAIN DEFINITION------------------------
geometry.is_periodic = 1 1 0              # For each dir, 0: non-perio, 1: periodic
geometry.coord_sys   = 0                  # 0 => cart, 1 => RZ
geometry.prob_lo     = 0.0 0.0 0.0        # x_lo y_lo (z_lo)
geometry.prob_hi     = 0.008 0.008 0.016  # x_hi y_hi (z_hi)

# >>>>>>>>>>>>>  BC FLAGS <<<<<<<<<<<<<<<<
# Interior, Inflow, Outflow, Symmetry,
# SlipWallAdiab, NoSlipWallAdiab, SlipWallIsotherm, NoSlipWallIsotherm
peleLM.lo_bc = Interior Interior Inflow
peleLM.hi_bc = Interior Interior Outflow


#-------------------------AMR CONTROL----------------------------
amr.n_cell          = 32 32 64   # Level 0 number of cells 
amr.v               = 1                # AMR verbose
amr.max_level       = 1                # maximum level number allowed
amr.ref_ratio       = 2 2 2 2          # refinement ratio
amr.regrid_int      = 2                # how often to regrid
amr.n_error_buf     = 2 2 2 2          # number of buffer cells in error est
amr.grid_eff        = 0.7              # what constitutes an efficient grid
amr.blocking_factor = 16               # block factor in grid generation (min box size)
amr.max_grid_size   = 64               # max box size


#--------------------------- Problem -------------------------------
prob.P_mean = 101325.0
prob.standoff = -.012
prob.pertmag = 0.0004
pmf.datafile = "dodecaneLu_pmf.dat"

#-------------------------PeleLM CONTROL----------------------------
peleLM.v = 4
peleLM.incompressible = 0
peleLM.rho = 1.17
peleLM.mu = 0.0
peleLM.use_wbar = 1
peleLM.sdc_iterMax = 2
peleLM.floor_species = 0

peleLM.do_temporals = 0

#amr.restart = chk00005
#amr.check_int = 2000
amr.plot_int = 100
amr.max_step = 5
amr.dt_shrink = 0.0001
amr.stop_time = 0.001
#amr.stop_time = 1.00
amr.cfl = 0.5
amr.derive_plot_vars = avg_pressure mag_vort mass_fractions

# --------------- INPUTS TO CHEMISTRY REACTOR ---------------
peleLM.chem_integrator = "ReactorCvode"
peleLM.use_typ_vals_chem = 1          # Use species/temp typical values in CVODE
ode.rtol = 1.0e-6                     # Relative tolerance of the chemical solve
ode.atol = 1.0e-5                     # Absolute tolerance factor applied on typical values
cvode.solve_type = denseAJ_direct     # CVODE Linear solve type (for Newton direction)
# GMRES is 6x (GPU) to 19x (CPU) slower than a direct solve here. On GPU, build
# with PELE_CVODE_FORCE_YCORDER=TRUE and use cvode.solve_type = sparse_direct;
# ode.atol = 1.0e-4 there cuts the step cost by a third.
cvode.max_order  = 4                  # CVODE max BDF order. 
# Chemistry box size (default: the flow boxes). CPU with many MPI ranks: 8
# spreads the flame chemistry over more ranks (63 ranks with flow boxes of 16:
# -14% per step, -17% at dt 5e-6). GPU with sparse_direct: 32 gives -21% per
# step (smaller batched CVODE systems take larger steps); 16 or 8 is slower.
#peleLM.max_grid_size_chem = 8     # CPU
#peleLM.max_grid_size_chem = 32    # GPU

#--------------------REFINEMENT CONTROL------------------------
#amr.refinement_indicators = temp
#amr.temp.max_level     = 1
#amr.temp.value_greater = 305
#amr.temp.field_name    = temp

#amr.refinement_indicators = magVort
#amr.magVort.max_level     = 1
#amr.magVort.value_greater = 500.0
#amr.magVort.field_name    = mag_vort

amr.refinement_indicators = yH
amr.yH.max_level     = 3
amr.yH.value_greater = 2.0e-5
amr.yH.field_name    = Y(H)

#amrex.fpe_trap_invalid = 1
#amrex.fpe_trap_zero = 1
#amrex.fpe_trap_overflow = 1

amrex.the_arena_is_managed=1
amrex.abort_on_out_of_gpu_memory = 1
amrex.signal_handling=0
